# Database
# Connection pool parameters:
# - connection_limit: Max connections in pool (default: num_cpus * 2 + 1, use 1-5 for serverless)
# - pool_timeout: Seconds to wait for connection from pool (default: 10)
# - connect_timeout: Seconds to wait when creating new connection (default: 5)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require&connection_limit=10&pool_timeout=20"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server Configuration
NODE_ENV="development"
PORT=3005

# CORS Configuration (comma-separated list of allowed origins)
# Development: http://localhost:3000,http://localhost:3005
# Production: https://kirim.chat,https://app.kirim.chat,https://www.kirim.chat
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3005"

# Meta/WhatsApp Configuration
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
# META_ACCESS_TOKEN is REMOVED - Each WABA uses its own OAuth token stored in WhatsAppAccount table (per Meta policy)
META_VERIFY_TOKEN="your-meta-webhook-verify-token"
META_CONFIG_ID="your-meta-embedded-signup-config-id"

# WABA Embedded Signup Configuration
# Note: This should point to FRONTEND URL, not backend. Meta redirects here after OAuth.
OAUTH_REDIRECT_URI="http://localhost:3000/waba/callback"
WEBHOOK_BASE_URL="http://localhost:3005"
WABA_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# Email Configuration (Provider-Agnostic SMTP)
# Works with any SMTP provider: Brevo, SendGrid, Mailgun, AWS SES, Gmail, etc.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-smtp-login"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="noreply@kirim.chat"
SMTP_FROM_NAME="KirimChat"
SMTP_SECURE=false

# Common SMTP Providers:
# Brevo: smtp-relay.brevo.com:587
# SendGrid: smtp.sendgrid.net:587 (use API key as password)
# Mailgun: smtp.mailgun.org:587
# AWS SES: email-smtp.{region}.amazonaws.com:587
# Gmail: smtp.gmail.com:587 (use App Password)

# Email Notifications
EMAIL_NOTIFICATIONS_ENABLED=true

# File Upload Configuration
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL="info"

# Sentry
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Redis Configuration (REQUIRED for rate limiting and BullMQ)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD="your-redis-password"  # Uncomment if Redis requires auth
# REDIS_TLS="true"  # Uncomment for production with TLS

# Security
BCRYPT_ROUNDS=12
JWT_EXPIRES_IN="24h"
TWO_FACTOR_ISSUER="kirim.chat Platform"

# Branding Configuration
# API key prefix for generated keys (e.g., "kc" generates "kc_live_xxx")
# Change this to match your brand (e.g., "otk" for Otika, "myapp" for MyApp)
API_KEY_PREFIX="kc"

# Webhook header prefix for white-label (default: KirimChat)
# Changes webhook headers: X-{PREFIX}-Signature, X-{PREFIX}-Event, etc.
# Example: WEBHOOK_HEADER_PREFIX=MyBrand -> X-MyBrand-Signature
WEBHOOK_HEADER_PREFIX="KirimChat"

# Better Auth
BETTER_AUTH_SECRET="your-super-secret-better-auth-key-change-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Public URL (for media links - MUST match frontend API URL)
# Development: http://localhost:3005
# Production: https://api.kirim.chat
# AI Configuration
OPENAI_API_KEY="your key"
PUBLIC_URL="http://localhost:3005"

# Instagram API Configuration
# Get these from Meta App Dashboard > Instagram > API setup with Instagram
INSTAGRAM_APP_ID="your-instagram-app-id"
INSTAGRAM_APP_SECRET="your-instagram-app-secret"
INSTAGRAM_REDIRECT_URI="http://localhost:3005/api/v1/ig/auth/callback"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="your-instagram-webhook-verify-token"

# Frontend URL (for OAuth redirects)
FRONTEND_URL="http://localhost:3000"
BACKEND_URL=http://localhost:3005
COOKIE_DOMAIN=".domain.com"