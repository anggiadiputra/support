    "@prisma/client": "5.22.0",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.6.23",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "hono": "^4.12.28",
    "ioredis": "^5.4.2",
    "jose": "^6.2.3",
    "langchain": "^1.0.6",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
