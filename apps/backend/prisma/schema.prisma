  pageId        String  @unique // Facebook Page ID
  pageName      String
  pageCategory  String?
  profilePicUrl String?

  // Token (encrypted) - Page Access Token
  accessToken        String
  accessTokenIV      String
  accessTokenTag     String
  tokenExpiresAt     DateTime?
  tokenLastRefresh   DateTime?
  grantedPermissions String[]

  // Connection status
  connectionStatus String    @default("connected")
  connectedAt      DateTime  @default(now())
  lastSyncAt       DateTime?

