// Template Variable Management Models

enum VariableType {
  TEXT
  URL
  CURRENCY
  DATE
  IMAGE
  VIDEO
  DOCUMENT
}

enum BulkSendStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Conversation Assignment Types
enum ConversationType {
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

enum AssigneeType {
  HUMAN
  AI_AGENT
}

model TemplateVariable {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String // User-defined name: "Nama Customer", "Link Tracking"
  type         VariableType
  description  String?
  exampleValue String?
  usageCount   Int          @default(0)

  templateMappings TemplateVariableMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model TemplateVariableMapping {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateName   String // WhatsApp template name
  componentType  String // "body", "header", "button"
  componentIndex Int // Which component (for multiple buttons)
  parameterIndex Int // Position in component ({{1}}, {{2}})
  variableId     String
  variable       TemplateVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, templateName, componentType, componentIndex, parameterIndex])
  @@index([userId, templateName])
}

model TemplateVariableHistory {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateName String
  variableId   String
  value        String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, templateName])
  @@index([userId, variableId])
  @@index([createdAt])
}

model BulkTemplateSend {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateName    String
  status          BulkSendStatus @default(PENDING)
  totalRecipients Int
  successCount    Int            @default(0)
  failedCount     Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  readCount       Int            @default(0)
  csvData         Json // Store CSV data
  results         Json? // Store results per recipient
  completedAt     DateTime?

  // Recovery fields for resuming interrupted broadcasts
  lastProcessedIndex Int       @default(0) // Index of last processed recipient (for resume)
  lastHeartbeat      DateTime? // Last activity timestamp (for detecting stuck jobs)
  senderPhoneNumberId String?  // Phone number ID used for sending (for resume)
  messageDelayMs     Int       @default(1000) // Delay between messages in ms

  // Relation to track individual messages for delivery status
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, lastHeartbeat]) // For finding stuck jobs
}

// Conversation Assignment Model for OneInbox
model ConversationAssignment {
  id               String           @id @default(cuid())
  conversationId   String // Customer ID for WhatsApp, IGConversation ID for Instagram
  conversationType ConversationType

  // Assignment type (HUMAN or AI_AGENT)
  assigneeType AssigneeType @default(HUMAN)

  // Human assignment (when assigneeType = HUMAN)
  assigneeId String? // User ID of assignee (Agent or Business Owner) - nullable for AI assignments
  assignee   User?   @relation("AssignedConversations", fields: [assigneeId], references: [id], onDelete: Cascade)

  // AI Agent assignment (when assigneeType = AI_AGENT)
  aiAgentId String? // AIAgent ID - nullable for human assignments
  aiAgent   AIAgent? @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)

  assignedById String // User ID of who made the assignment
  assignedBy   User   @relation("AssignmentsMade", fields: [assignedById], references: [id], onDelete: Cascade)

  // Business owner context
  businessOwnerId String // For scoping queries
  businessOwner   User   @relation("BusinessOwnerAssignments", fields: [businessOwnerId], references: [id], onDelete: Cascade)

  // Escalation info (when assignment is triggered by escalation keyword)
  isEscalation          Boolean @default(false)
  escalationKeywordGroup String? // Name of the keyword group that triggered escalation
  escalationKeyword     String? // The specific keyword that was matched

  // Timestamps
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime? // Null = currently active

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, conversationType])
  @@index([assigneeId])
  @@index([aiAgentId])
  @@index([businessOwnerId])
  @@index([unassignedAt])
}

// Admin Broadcast Models
enum BroadcastStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  MESSAGE_RETENTION
  SUBSCRIPTION_EXPIRY
  PAYMENT_STATUS
  API_KEY_EXPIRY
  SYSTEM_ANNOUNCEMENT
  MAINTENANCE
  PROMOTION
  CUSTOM
  ESCALATION_ASSIGNMENT // New conversation assigned due to escalation keyword
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PhoneSource {
  REGISTRATION
  WABA
}

model AdminBroadcast {
  id String @id @default(cuid())

  adminId String
  admin   User   @relation("AdminBroadcasts", fields: [adminId], references: [id], onDelete: Cascade)

  templateName String
  templateData Json

  filters Json

  totalRecipients Int @default(0)
  totalSent       Int @default(0)
  totalFailed     Int @default(0)
  totalPending    Int @default(0)

  status BroadcastStatus @default(PENDING)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients AdminBroadcastRecipient[]

  @@index([adminId])
  @@index([status])
  @@index([createdAt])
}

model AdminBroadcastRecipient {
  id String @id @default(cuid())

  broadcastId String
  broadcast   AdminBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  userId      String
  phoneNumber String
  phoneSource PhoneSource

  status       MessageStatus @default(PENDING)
  errorMessage String?
  messageId    String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([broadcastId])
  @@index([status])
}

// Notification System Models

// Enum for recipient selection type in admin notifications
enum NotificationRecipientType {
  SINGLE
  MULTIPLE
  ALL
  BY_TIER
}

// Tracks batch notifications sent by admin
model NotificationBatch {
  id          String               @id @default(cuid())
  title       String
  message     String               @db.Text
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  actionUrl   String?
  actionLabel String?
  expiresAt   DateTime?

  recipientType   NotificationRecipientType
  recipientFilter Json? // Store tier filter if by_tier, or user IDs if multiple
  recipientCount  Int

  sentBy String // Admin user ID
  sentAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admin         User           @relation("AdminNotificationBatches", fields: [sentBy], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([sentAt])
  @@index([type])
  @@index([sentBy])
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  priority    NotificationPriority @default(NORMAL)
  actionUrl   String?
  actionLabel String?
  isRead      Boolean              @default(false)
  readAt      DateTime?
  metadata    Json? // Extra data specific to notification type
  expiresAt   DateTime? // Auto-dismiss after this date
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Optional batch reference for admin-sent notifications
  batchId String?
  batch   NotificationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
  @@index([batchId])
}

// Subscription Rules & Promo Codes System

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  NONE
}

model SubscriptionRule {
  id   String           @id @default(cuid())
  tier SubscriptionTier @unique

  // Duration controls
  minDurationMonths Int  @default(1) // Minimum months user must buy
  maxDurationMonths Int? @default(12) // Max months (null = unlimited)
  allowedDurations  Json // Array of allowed months: [1,3,6,12]

  // Status
  isActive Boolean @default(true)

  // Metadata
  updatedBy String? // Admin user ID who last updated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id   String @id @default(cuid())
  code String @unique // e.g., "ANNUAL30", "LITE3M"

  // Discount settings
  discountType  DiscountType // PERCENTAGE, FIXED_AMOUNT, NONE
  discountValue Int          @default(0) // 20 (for 20%), or 50000 (for Rp 50k off)

  // Duration enforcement (optional - overrides SubscriptionRule)
  minDurationMonths Int? // If set, overrides tier's minDuration
  allowedDurations  Json? // If set, overrides tier's allowedDurations

  // Restrictions
  applicableTiers Json // ["BASIC", "LITE"] or ["ALL"]
  maxUsages       Int? // null = unlimited
  currentUsages   Int  @default(0)

  // Validity
  startsAt  DateTime
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  // Metadata
  description String?
  createdBy   String // Admin user ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([startsAt, expiresAt])
}

// =============================================================================
// Auto Tagging System Models
// =============================================================================

model AutoTagRule {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rule Configuration
  name     String   // e.g., "Interested Buyer", "Support Request"
  keywords String[] // ["harga", "price", "biaya"] - case-insensitive matching
  priority Int      @default(10) // 1-100, higher = executed first
  isActive Boolean  @default(true)

  // Actions
  addTags               String[] // Tags to add when rule matches
  moveToPipelineStageId String? // Optional: move customer to this stage
  moveToPipelineStage   PipelineStage? @relation(fields: [moveToPipelineStageId], references: [id], onDelete: SetNull)

  // Statistics
  matchCount  Int       @default(0) // Number of times this rule matched
  lastMatchAt DateTime? // Last time this rule matched

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([priority])
}

// =============================================================================
// Quick Replies System Models
// =============================================================================

model QuickReplyCategory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  order Int    @default(0)

  quickReplies QuickReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([order])
}

model QuickReply {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   QuickReplyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  shortcut String // Unique shortcut without "/" prefix
  title    String // Display name
  content  String @db.Text // Message content with variables

  createdById String
  createdBy   User   @relation("QuickReplyCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, shortcut])
  @@index([userId])
  @@index([categoryId])
  @@index([createdById])
}

// =============================================================================
// Affiliate System Models
// =============================================================================

// Global affiliate configuration (admin-managed)
model AffiliateConfig {
  id                   String  @id @default(cuid())
  commissionPercentage Int     @default(10) // 10 = 10%
  holdingPeriodDays    Int     @default(14) // Days before commission is credited
  isEnabled            Boolean @default(true) // Global on/off switch

  // Referred user bonus settings
  referredUserBonusEnabled Boolean @default(false) // Enable bonus for referred users
  referredUserBonusAmount  Int     @default(0) // Bonus amount in IDR

  updatedBy String? // Admin user ID who last updated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Affiliate profile for each user
model Affiliate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  referralCode     String        @unique // Random 6-char code: "X7K9M2"
  isActive         Boolean       @default(true) // Admin can disable
  customCommission Int? // Override global commission % (null = use global)
  tier             AffiliateTier @default(STANDARD) // Kept for backward compatibility (not used)

  // Stats (denormalized for performance)
  totalEarnings  Int @default(0) // Total commission earned (IDR)
  totalReferrals Int @default(0) // Number of users referred

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  referrals   Referral[]
  commissions AffiliateCommission[]

  @@index([referralCode])
  @@index([isActive])
}

// Tracks who referred whom (1 user can only have 1 referrer)
model Referral {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  referredUserId String @unique // User who was referred (1 user = 1 referrer only)
  referredUser   User   @relation("ReferredByAffiliate", fields: [referredUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) // When user registered via referral link

  @@index([affiliateId])
}

// Commission earned per transaction
model AffiliateCommission {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  referredUserId       String // User who made the transaction
  // NOTE: orderId is NOT @unique by design. Idempotency is handled at service level (findFirst check).
  // Adding @unique would require migration that risks data loss in multi-tenant production environments.
  // Current approach: webhook idempotency + service-level check is sufficient for race condition prevention.
  orderId              String // PaymentTransaction orderId (idempotency checked in affiliate-service.ts:539)
  transactionType      String // "SUBSCRIPTION" | "TOP_UP"
  transactionAmount    Int // Transaction amount (IDR)
  commissionPercentage Int // Commission % at time of transaction (for history)
  commissionAmount     Int // Commission amount (IDR)

  status     AffiliateCommissionStatus @default(PENDING)
  releaseAt  DateTime // When commission will be credited (after holding period)
  creditedAt DateTime? // When commission was added to credit balance

  // Admin action tracking
  cancelledAt DateTime? // When commission was cancelled
  cancelledBy String? // Admin user ID who cancelled
  releasedBy  String? // Admin user ID who released early

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
  @@index([releaseAt])
  @@index([orderId])
}
