  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, syncType])
  @@index([userId])
  @@index([whatsappAccountId])
  @@index([syncType])
  @@index([status])
}

// AI & Knowledge Base Models

model AIConfig {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled              Boolean @default(false)
  model                String  @default("gpt-4.1-nano-2025-04-14")
  systemPrompt         String  @default("You are a helpful customer support assistant.")
  temperature          Float   @default(0.7)
  maxDailyInteractions Int     @default(100)

  filterWords       Json? // Array of strings
  excludedCustomers Json? // Array of { type: 'phone' | 'customerId', value: string, label?: string }

  // Working Hours - AI only responds during configured hours
  timezone     String @default("Asia/Jakarta")
  workingHours Json?  // { "monday": { "start": "09:00", "end": "17:00" }, ... } - null day = off

  // Escalation - Keywords that trigger handover to human
  escalationKeywords   Json?   // Array of strings: ["bicara cs", "komplain", "refund"]
  escalationAutoAssign Boolean @default(true) // true = assign to human queue, false = just stop AI

  activeAgentId String?
  activeAgent   AIAgent? @relation(fields: [activeAgentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activeAgentId])
}

model WhatsAppAccountAIConfig {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappAccountId String
  whatsappAccount   WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  enabled       Boolean @default(false)
  activeAgentId String?
  activeAgent   AIAgent? @relation(fields: [activeAgentId], references: [id], onDelete: SetNull)
  temperature       Float   @default(0.7)
  filterWords       Json?
  excludedCustomers Json? // Array of { type: 'phone' | 'customerId', value: string, label?: string }

  // Working Hours - AI only responds during configured hours
  timezone     String @default("Asia/Jakarta")
  workingHours Json?  // { "monday": { "start": "09:00", "end": "17:00" }, ... } - null day = off

  // Escalation - Keywords that trigger handover to human
  escalationKeywords   Json?   // Array of strings: ["bicara cs", "komplain", "refund"]
  escalationAutoAssign Boolean @default(true) // true = assign to human queue, false = just stop AI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to escalation keyword groups
  escalationKeywordGroups EscalationKeywordGroup[]

  @@unique([userId, whatsappAccountId])
  @@index([whatsappAccountId])
  @@index([activeAgentId])
}

// Escalation Keyword Groups - Map keywords to specific agents
model EscalationKeywordGroup {
  id                      String              @id @default(cuid())
  whatsappAccountAIConfigId String
  whatsappAccountAIConfig WhatsAppAccountAIConfig @relation(fields: [whatsappAccountAIConfigId], references: [id], onDelete: Cascade)

  name     String   // Group name, e.g., "Finance", "Technical Support"
  keywords Json     // Array of keywords: ["billing", "tagihan", "bayar"]

  // Agent to assign when keyword matches
  assignedAgentId String
  assignedAgent   User   @relation("EscalationAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsappAccountAIConfigId])
  @@index([assignedAgentId])
}

model AIAgent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  systemPrompt String @db.Text

  knowledgeDocuments KnowledgeDocument[]
  aiConfigs          AIConfig[]
  whatsappAccountAIConfigs WhatsAppAccountAIConfig[]

  // Conversation assignments where this AI Agent is assigned
  conversationAssignments ConversationAssignment[]

  // Conversation Memory Relations
  conversationMemories ConversationMemory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model KnowledgeDocument {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename     String
  fileSize     Int
  mimeType     String           @default("application/pdf")
  status       ProcessingStatus @default(PENDING)
  errorMessage String?

  chunks DocumentChunk[]
  agents AIAgent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model DocumentChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  content    String @db.Text
  chunkIndex Int
  tokenCount Int

  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())

  @@index([documentId])
}

model ConversationMemory {
  id                 String        @id @default(cuid())

  // Isolation keys
  userId             String
  customerId         String
  whatsappAccountId  String

  // Optional: AI Agent that responded
  aiAgentId          String?

  // Memory content
  memoryType         MemoryType
  customerMessage    String        @db.Text
  responseMessage    String        @db.Text

  // Embedding
  embedding          Unsupported("vector(1536)")?
  embeddingText      String?       @db.Text
  status             MemoryStatus  @default(PENDING)
  retryCount         Int           @default(0)

  // Message references
  inboundMessageId   String?
  outboundMessageId  String?

  // Metadata & timestamps
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsappAccount    WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  aiAgent            AIAgent?      @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([userId, customerId, whatsappAccountId])
  @@index([status])
  @@index([createdAt])
}

// CRM Models

model Pipeline {
