// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BUSINESS_OWNER
  AGENT
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum QualityRatingEnum {
  HIGH
  MEDIUM
  LOW
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  BUTTONS
  LIST
  STICKER
  CONTACTS
  LOCATION
  INTERACTIVE
  REACTION
  BUTTON
  EDIT
  UNSUPPORTED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  PLAYED
  PENDING
  ERROR
}

enum MessageSource {
  API
  AI_BOT
  WHATSAPP_APP
  INSTAGRAM
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

enum IGMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  STICKER
  STORY_REPLY
  STORY_MENTION
  MEDIA_SHARE
  REACTION
}

enum MessengerMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STICKER
  TEMPLATE
  QUICK_REPLY
  REACTION
}

enum ConsentAction {
  OPT_IN
  OPT_OUT
  UPDATE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionTier {
  FREE
  BASIC
  LITE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  QRIS
  VA_BCA
  VA_BNI
  VA_MANDIRI
  VA_PERMATA
}

enum CreditTransactionType {
  PRORATE_EXCESS // Excess prorate credit stored
  PAYMENT_USED // Credit used for payment
  ADMIN_ADJUSTMENT // Admin manual add/subtract
  REFUND // Refund credit
  AUTO_RENEWAL // Credit used for auto-renewal
  TOP_UP // Credit added via top-up payment
  AFFILIATE_COMMISSION // Commission from affiliate referral
  REFERRAL_BONUS // Bonus credit for referred user
}

// Payment Transaction Type (for distinguishing subscription vs top-up payments)
enum PaymentTransactionType {
  SUBSCRIPTION
  TOP_UP
}

// Affiliate System Enums

enum AffiliateTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

enum AffiliateCommissionStatus {
  PENDING // Waiting for holding period
  CREDITED // Added to credit balance
  CANCELLED // Cancelled (e.g., refund)
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
  FAILED
}

enum WABAHealthStatus {
  ACTIVE
  RESTRICTED
  UNDER_REVIEW
  FLAGGED
  DISABLED
}

// Conversation Memory Enums
enum MemoryType {
  AI_REPLY      // AI auto-response
  HUMAN_REPLY   // Agent reply from dashboard
  SMB_ECHO      // Owner reply from WA app
}

enum MemoryStatus {
  PENDING       // Queued, not yet embedded
  COMPLETED     // Embedding successful
  FAILED        // Failed after retries
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier   SubscriptionTier   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  // Validity
  startDate DateTime  @default(now())
  endDate   DateTime? // Null = lifetime/indefinite

  // Auto-renewal settings
  autoRenewEnabled        Boolean   @default(true)
  autoRenewDurationMonths Int       @default(1) // 1, 3, 6, or 12
  lastAutoRenewalAt       DateTime? // For idempotency check

  // Manual Payment Tracking
  paymentProof String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PaymentTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Order details
  orderId       String        @unique // partnerReferenceNo for Duitku
  amount        Int // Amount in IDR (no decimals)
  paymentMethod PaymentMethod

  // Provider tracking
  providerId String @default("duitku") // Payment provider ID (duitku, xendit, etc.)

  // Subscription details
  targetTier   SubscriptionTier
  durationDays Int              @default(30)

  // Promo code tracking
  promoCode      String? // Promo code used for this transaction
  discountAmount Int? // Discount amount applied (in IDR)

  // Prorate credit (from remaining subscription when upgrading)
  prorateCredit Int? // Credit amount from remaining subscription (in IDR)

  // Top-up credit support
  creditUsed      Int                    @default(0)            // Amount of credit used in this transaction
  transactionType PaymentTransactionType @default(SUBSCRIPTION) // Transaction type: SUBSCRIPTION or TOP_UP

  // Provider response
  referenceNo String? // Provider reference number
  qrString    String? @db.Text // QR code string
  qrUrl       String? // QR code image URL
  vaNumber    String? // Virtual Account number (for VA payments)

  // Status
  status    PaymentStatus @default(PENDING)
  expiresAt DateTime
  paidAt    DateTime?

  // Callback data
  callbackPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([providerId])
  @@index([status])
  @@index([expiresAt])
  @@index([transactionType])
}

// Credit Balance System Models

model CreditBalance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance Int @default(0) // Current balance in IDR

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          CreditTransactionType
  amount        Int // Positive = added, Negative = used
  balanceBefore Int
  balanceAfter  Int

  // Reference to related entities
  paymentTransactionId String?
  orderId              String?

  // Admin adjustment fields
  adminUserId String?
  reason      String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// Team Agent Management Models

model TeamMember {
  id              String  @id @default(cuid())
  businessOwnerId String
  businessOwner   User    @relation("BusinessOwnerTeam", fields: [businessOwnerId], references: [id], onDelete: Cascade)
  agentUserId     String? @unique
  agent           User?   @relation("AgentMembership", fields: [agentUserId], references: [id], onDelete: SetNull)

  status TeamMemberStatus @default(PENDING)

  invitedAt DateTime  @default(now())
  joinedAt  DateTime?
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessOwnerId])
  @@index([status])
}

model Invitation {
  id              String @id @default(cuid())
  businessOwnerId String
  businessOwner   User   @relation(fields: [businessOwnerId], references: [id], onDelete: Cascade)

  email  String
  token  String           @unique
  status InvitationStatus @default(PENDING)

  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?

  // Track email delivery
  emailSentAt DateTime?
  emailError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessOwnerId, email])
  @@index([businessOwnerId])
  @@index([token])
  @@index([status])
}

model WABAAccountStatus {
  id              String           @id @default(cuid())
  wabaId          String
  phoneNumberId   String?
  status          WABAHealthStatus @default(ACTIVE)
  restrictionType String? // ACCOUNT_LOCKED, POLICY_VIOLATION, SPAM_RATE_LIMIT, DELIVERY_BLOCKED
  errorCode       Int?
  errorMessage    String?
  detectedAt      DateTime         @default(now())
  resolvedAt      DateTime?
  detectedFrom    String // ERROR_RESPONSE, API_POLLING
  rawResponse     Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([wabaId])
  @@index([status])
  @@index([detectedAt])
}

model MetaApp {
  id                 String    @id @default(cuid())
  appId              String    @unique
  appSecret          String
  techProviderStatus String    @default("pending")
  termsAcceptedAt    DateTime?
  users              User[]
  whatsappAccounts   WhatsAppAccount[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model WhatsAppAccount {
  id       String  @id @default(cuid())
  wabaId   String  @unique
  wabaName String?

  // Token (encrypted per-account)
  accessToken    String
  accessTokenIV  String
  accessTokenTag String
  tokenExpiresAt   DateTime?
  tokenLastRefresh DateTime?

  // WABA metadata
  verifiedStatus           String  @default("unverified")
  messagingTier            String?
  timezoneId               String?
  currency                 String?
  messageTemplateNamespace String?

  // Webhook Configuration
  webhookVerifyToken      String?
  webhookSubscribedAt     DateTime?
  webhookSubscribedEvents Json?

  // Connection status
  connectionStatus String   @default("connected")
  connectedAt      DateTime @default(now())
  lastSyncAt       DateTime?

  // Manual login (user provides own access token + WABA ID)
  isManualLogin           Boolean   @default(false)

  // Coexistence (WhatsApp Business App + Cloud API)
  isCoexistence           Boolean   @default(false)
  coexistenceSyncProgress Int?
  coexistenceSyncStatus   String?
  historySharingConsent   Boolean   @default(false)
  contactSyncCompletedAt  DateTime?
  historySyncCompletedAt  DateTime?

  // Meta App relationship
  metaAppId String?
  metaApp   MetaApp? @relation(fields: [metaAppId], references: [id])

  // Owner
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  phoneNumbers        PhoneNumber[]
  connectionLogs      WABAConnectionLog[]
  qualityRatings      QualityRating[]
  messageTemplates    MessageTemplate[]
  coexistenceSyncLogs CoexistenceSyncStatus[]
  aiConfigs           WhatsAppAccountAIConfig[]

  // Conversation Memory Relations
  conversationMemories ConversationMemory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([wabaId])
  @@index([connectionStatus])
  @@index([metaAppId])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  role            Role      @default(BUSINESS_OWNER)
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  image           String?

  // Legacy fields (keep for backward compatibility)
  passwordHash     String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  isActive         Boolean   @default(true)

  country          String?
  subscriptionTier String @default("FREE")

  // Meta App relationship
  metaAppId String?
  metaApp   MetaApp? @relation(fields: [metaAppId], references: [id])

  // Relationships
  qualityRatings      QualityRating[]
  customers           Customer[]
  messageTemplates    MessageTemplate[]
  messages            Message[]
  webhookEvents       WebhookEvent[]
  auditLogs           AuditLog[]
  phoneNumbers        PhoneNumber[]
  wabaConnectionLogs  WABAConnectionLog[]
  consentLogs         ConsentLog[]
  sessions            Session[]
  accounts            Account[]
  whatsappContacts    WhatsAppContact[]
  coexistenceSyncLogs CoexistenceSyncStatus[]

  // Billing
  subscription        Subscription?
  paymentTransactions PaymentTransaction[]
  creditBalance       CreditBalance?
  creditTransactions  CreditTransaction[]

  // AI Features
  aiConfig                AIConfig?
  knowledgeDocuments      KnowledgeDocument[]
  agents                  AIAgent[]
  whatsappAccountAIConfigs WhatsAppAccountAIConfig[]

  // CRM Relations
  pipelines              Pipeline[]
  customFieldDefinitions CustomFieldDefinition[]
  customerActivities     CustomerActivity[]
  customerNotes          CustomerNote[]

  // WhatsApp Relations
  whatsappAccounts WhatsAppAccount[]

  // Instagram Relations
  instagramAccounts InstagramAccount[]

  // Facebook Messenger Relations
  facebookPages FacebookPage[]

  // Webhook & Public API Relations
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]

  // Admin Settings
  systemSettings   SystemSetting[]
  emailTemplates   EmailTemplate[] @relation("EmailTemplateUpdatedBy")

  // Team Agent Management Relations
  teamMembers     TeamMember[] @relation("BusinessOwnerTeam")
  agentMembership TeamMember?  @relation("AgentMembership")
  invitations     Invitation[]

  // Admin Broadcast Relations
  adminBroadcasts AdminBroadcast[] @relation("AdminBroadcasts")

  // Template Variable Management Relations
  templateVariables        TemplateVariable[]
  templateVariableMappings TemplateVariableMapping[]
  templateVariableHistory  TemplateVariableHistory[]
  bulkTemplateSends        BulkTemplateSend[]

  // Conversation Assignment Relations
  assignedConversations    ConversationAssignment[] @relation("AssignedConversations")
  assignmentsMade          ConversationAssignment[] @relation("AssignmentsMade")
  businessOwnerAssignments ConversationAssignment[] @relation("BusinessOwnerAssignments")

  // Notification Relations
  notifications            Notification[]
  adminNotificationBatches NotificationBatch[] @relation("AdminNotificationBatches")

  // Affiliate Relations
  affiliate  Affiliate? // User's affiliate profile
  referredBy Referral?  @relation("ReferredByAffiliate") // Who referred this user

  // Auto Tagging Relations
  autoTagRules AutoTagRule[]

  // Conversation Memory Relations
  conversationMemories ConversationMemory[]

  // Escalation Keyword Group Relations
  escalationAssignments EscalationKeywordGroup[] @relation("EscalationAssignedAgent")

  // Quick Reply Relations
  quickReplyCategories QuickReplyCategory[]
  quickReplies         QuickReply[]
  quickRepliesCreated  QuickReply[]         @relation("QuickReplyCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([metaAppId])
}

model QualityRating {
  id                   String            @id @default(cuid())
  phoneNumberId        String
  rating               QualityRatingEnum
  status               String // Connected/Flagged/Restricted
  blockCount7days      Int               @default(0)
  spamReportCount7days Int               @default(0)
  blockReasons         Json?
  measuredAt           DateTime          @default(now())

  // Relationships
  whatsappAccountId String?
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([whatsappAccountId])
  @@index([phoneNumberId])
  @@index([measuredAt])
}

model Customer {
  id                String    @id @default(cuid())
  phoneNumber       String
  name              String?
  email             String?
  consentStatus     Boolean   @default(false)
  consentCapturedAt DateTime?
  consentSource     String?
  consentPurpose    String?
  blacklisted       Boolean   @default(false)

  // Marketing opt-out (Meta WhatsApp policy: user_preferences webhook + error 131050)
  // Distinct from consentStatus: applies ONLY to MARKETING category templates.
  // Utility/Authentication templates and freeform (in-window) messages remain allowed.
  marketingOptOut       Boolean   @default(false)
  marketingOptOutAt     DateTime?
  marketingOptOutSource String?   // 'META_USER_PREFERENCE' | 'META_ERROR_131050' | 'MANUAL'

  // 24-Hour Messaging Window (Meta Policy)
  lastInboundMessageAt DateTime? // Last time customer sent message
  windowExpiresAt      DateTime? // When 24h window expires (lastInbound + 24h)
  isWindowActive       Boolean   @default(false) // Is window currently active

  // CRM Fields
  leadScore Int      @default(0)
  notes     String?  @db.Text // Simple notes field (deprecated, use CustomerNote model)
  tags      String[] // Simple array of tags

  // Instagram fields
  instagramIgsid    String? // Instagram-scoped User ID
  instagramUsername String?

  // WhatsApp BSUID (Business-Scoped User ID) - new identifier system
  // Format: <country_code>.<alphanumeric> (e.g., US.13491208655302741918)
  whatsappBsuid       String?   // Primary BSUID for this customer
  whatsappParentBsuid String?   // Parent BSUID (for linked business portfolios)
  whatsappUsername    String?   // WhatsApp username (if user enabled feature)
  bsuidMappedAt       DateTime? // When BSUID was first recorded

  // WhatsApp phone number link (which business number this customer chats with)
  whatsappPhoneNumberId String?
  whatsappPhoneNumber   PhoneNumber? @relation("WhatsAppPhoneCustomers", fields: [whatsappPhoneNumberId], references: [id])

  // Pipeline
  pipelineStageId String?
  pipelineStage   PipelineStage? @relation(fields: [pipelineStageId], references: [id])

  // Relationships
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages               Message[]
  consentLogs            ConsentLog[]
  marketingPreferenceLogs MarketingPreferenceLog[]
  customFields           CustomerCustomField[]
  activities             CustomerActivity[]
  igConversations        IGConversation[]
  messengerConversations MessengerConversation[]
  customerNotes          CustomerNote[]

  // Template Variable History
  templateVariableHistory TemplateVariableHistory[]

  // Conversation Memory Relations
  conversationMemories ConversationMemory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phoneNumber, whatsappPhoneNumberId])
  @@index([userId])
  @@index([userId, phoneNumber])
  @@index([phoneNumber])
  @@index([isWindowActive])
  @@index([windowExpiresAt])
  @@index([pipelineStageId])
  @@index([leadScore])
  @@index([instagramUsername])
  @@index([whatsappPhoneNumberId])
  @@index([whatsappBsuid])
  @@index([userId, whatsappBsuid])
  @@index([userId, marketingOptOut])
}

model MarketingPreferenceLog {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  action        String   // 'STOP' | 'RESUME'
  source        String   // 'META_USER_PREFERENCE' | 'META_ERROR_131050'
  detail        String?  // Meta payload detail or human-readable note
  metaTimestamp DateTime? // Original timestamp from Meta webhook payload (if available)
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model ConsentLog {
  id        String        @id @default(cuid())
  action    ConsentAction
  source    String
  purpose   String?
  ipAddress String?
  userAgent String?

  // Relationships
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  timestamp DateTime @default(now())

  @@index([customerId])
  @@index([userId])
  @@index([timestamp])
}

model MessageTemplate {
  id              String             @id @default(cuid())
  templateName    String
  category        TemplateCategory
  language        String             @default("en")
  content         String
  headerType      String?
  headerContent   String?
  footerContent   String?
  buttons         Json?
  variables       Json?
  status          TemplateStatus     @default(PENDING)
  qualityRating   QualityRatingEnum?
  rejectionReason String?
  appealStatus    String?
  submittedAt     DateTime           @default(now())
  approvedAt      DateTime?

  // Meta template ID
  metaTemplateId String?

  // Relationships
  whatsappAccountId   String?
  whatsappAccount     WhatsAppAccount?     @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateQualityLogs TemplateQualityLog[]
  messages            Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, whatsappAccountId, templateName, language])
  @@index([userId])
  @@index([whatsappAccountId])
  @@index([status])
  @@index([category])
}

model TemplateQualityLog {
  id               String            @id @default(cuid())
  qualityRating    QualityRatingEnum
  status           String
  feedbackCount24h Int               @default(0)
  measuredAt       DateTime          @default(now())

  // Relationships
  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId])
  @@index([measuredAt])
}

model Message {
  id           String           @id @default(cuid())
  messageType  MessageType
  direction    MessageDirection
  content      String?
  mediaUrl     String?
  status       MessageStatus    @default(SENT)
  wamId        String? // WhatsApp message ID
  errorCode    String?
  errorMessage String?
  timestamp    DateTime         @default(now())
  deletedAt    DateTime?

  // Coexistence fields
  source           MessageSource @default(API)
  deviceTimestamp  DateTime? // Original timestamp from device (for history sync)
  isHistoryMessage Boolean       @default(false) // Was synced from WhatsApp Business App history

  // WhatsApp phone number (which business number sent/received this message)
  whatsappPhoneNumberId String?
  whatsappPhoneNumber   PhoneNumber? @relation("WhatsAppPhoneMessages", fields: [whatsappPhoneNumberId], references: [id])

  // Relationships
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id])
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])

  // Broadcast job relationship (for tracking delivery status)
  bulkSendJobId String?
  bulkSendJob   BulkTemplateSend? @relation(fields: [bulkSendJobId], references: [id], onDelete: SetNull)

  // CTWA (Click-to-WhatsApp Ads) referral data from Meta webhook
  referral Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([templateId])
  @@index([timestamp])
  @@index([status])
  @@index([wamId])
  @@index([source])
  @@index([bulkSendJobId])
  @@index([whatsappPhoneNumberId])
}

model PhoneNumber {
  id                 String  @id @default(cuid())
  phoneNumberId      String  @unique
  displayPhoneNumber String
  verifiedName       String?
  qualityRating      String?
  messagingLimitTier String?
  isVerified         Boolean @default(false)
  isPrimary          Boolean @default(false)

  // Registration status from Meta API
  // Values: NOT_VERIFIED, VERIFIED, EXPIRED
  codeVerificationStatus String?
  // Account mode from Meta API
  // Values: SANDBOX, LIVE
  accountMode            String?
  // Display name status from Meta API
  // Values: NONE, NON_EXISTS, PENDING_REVIEW, AVAILABLE_WITHOUT_REVIEW, EXPIRED, APPROVED, DECLINED
  nameStatus             String?
  // Operational status from Meta API
  // Values: PENDING, DELETED, MIGRATED, BANNED, RESTRICTED, RATE_LIMITED, FLAGGED, CONNECTED, DISCONNECTED, UNKNOWN, UNVERIFIED
  status                 String?

  // WhatsApp Account relationship
  whatsappAccountId String?
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  // Relationships
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers Customer[] @relation("WhatsAppPhoneCustomers")
  messages  Message[]  @relation("WhatsAppPhoneMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([phoneNumberId])
  @@index([whatsappAccountId])
}

model WABAConnectionLog {
  id           String  @id @default(cuid())
  action       String
  details      Json?
  errorMessage String?

  // Relationships
  whatsappAccountId String?
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  timestamp DateTime @default(now())

  @@index([userId])
  @@index([whatsappAccountId])
  @@index([timestamp])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  // Relationships
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@index([processed])
  @@index([receivedAt])
}

model AuditLog {
  id         String  @id @default(cuid())
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?

  // Relationships
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([entityType, entityId])
}

// Better Auth Session Tables
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                   String    @id
  userId               String
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  idToken              String?
  expiresAt            DateTime?
  accessTokenExpiresAt DateTime? // Better Auth v1.3+ uses this field
  scope                String? // OAuth scope
  password             String?
  issuer               String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, providerId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identifier, value])
}

// Coexistence Models

model WhatsAppContact {
  id           String   @id @default(cuid())
  phoneNumber  String // Contact's WhatsApp phone number
  fullName     String? // Contact's full name from WhatsApp Business App
  firstName    String? // Contact's first name
  lastAction   String // add/remove
  lastSyncedAt DateTime @default(now())

  // WhatsApp BSUID (Business-Scoped User ID) — populated from coexistence
  // contact sync when Meta includes it. Nullable + backward-compatible: older
  // rows simply stay null. See docs/bsuid.md.
  whatsappBsuid       String? // Contact's BSUID, if provided by Meta
  whatsappParentBsuid String? // Parent BSUID (linked business portfolios)
  whatsappUsername    String? // WhatsApp username, if the contact adopted one

  // Relationships
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phoneNumber])
  @@index([userId])
  @@index([phoneNumber])
  @@index([whatsappBsuid])
}

model CoexistenceSyncStatus {
  id           String  @id @default(cuid())
  syncType     String // history/contacts
  phase        Int? // For history: 0, 1, 2
  chunkOrder   Int? // For history: chunk sequence number
  progress     Int     @default(0) // 0-100
  status       String  @default("pending") // pending/in_progress/completed/failed
  requestId    String? // Meta request ID for debugging
  errorMessage String?
  errorCode    Int?
  metadata     Json? // Additional sync metadata

