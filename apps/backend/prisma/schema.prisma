  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pageId])
  @@index([connectionStatus])
}

model MessengerConversation {
  id                    String  @id @default(cuid())
  participantPsid       String
  participantName       String?
  participantEmail      String?
  participantProfilePic String?

  // Messaging window (24h policy)
  lastInboundAt   DateTime?
  windowExpiresAt DateTime?
  isWindowActive  Boolean   @default(false)

  // Conversation state
  unreadCount        Int       @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?

  // Relationships
  facebookPageId String
  facebookPage   FacebookPage       @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  messages       MessengerMessage[]
  customerId     String?
  customer       Customer?          @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facebookPageId, participantPsid])
  @@index([facebookPageId])
  @@index([lastMessageAt])
  @@index([customerId])
}

model MessengerMessage {
  id          String               @id @default(cuid())
  mid         String?              @unique
  direction   MessageDirection
  messageType MessengerMessageType

  // Content
  text       String?
  mediaUrl   String?
  mediaType  String?
  fileName   String?
  stickerUrl String?

  // Quick replies & templates
  quickReplyPayload String?
  templatePayload   Json?

  // Status
  status       MessageStatus @default(SENT)
  errorCode    String?
  errorMessage String?

  // Reaction
  reaction String?

  // Read/Delivery receipts
  readAt      DateTime?
  deliveredAt DateTime?

  // Timestamps
  timestamp DateTime @default(now())

  // Relationships
  conversationId String
  conversation   MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([timestamp])
  @@index([mid])
}

model MessengerConnectionLog {
  id           String  @id @default(cuid())
  action       String
  details      Json?
  errorMessage String?

  facebookPageId String
  facebookPage   FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)

  timestamp DateTime @default(now())

  @@index([facebookPageId])
  @@index([timestamp])
}

model IGConversation {
  id                    String  @id @default(cuid())
  participantIgsid      String // Instagram-scoped ID of the other participant
  participantUsername   String?
  participantName       String?
  participantProfilePic String?
  followerCount         Int?
  isFollower            Boolean @default(false) // is_user_follow_business
  isFollowing           Boolean @default(false) // is_business_follow_user

  // Messaging window
  lastInboundAt   DateTime?
  windowExpiresAt DateTime?
  isWindowActive  Boolean   @default(false)

  // Conversation state
  unreadCount        Int       @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  folder             String    @default("primary") // primary, requests, general

